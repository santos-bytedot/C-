using System;

public class Program
{
    public static void Main(string[] args)
    {
        Console.Write ("Digite um numero: ");
        int num = int.Parse(Console.ReadLine());
        if (num > 0)
        {
            Console.Write("Seu numero e positivo! ");
        }
        else if (num < 0)
        {
            Console.Write("Seu numero e negativo! ");
        }
        else 
        {
            Console.Write("Seu numero e ZERO! ");
        }
        }
        
}
